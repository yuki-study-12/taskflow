<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">TaskFlow</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="dashboard" Match="NavLinkMatch.All">
                ダッシュボード
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="kanban">
                かんばんボード
            </NavLink>
        </div>
    </nav>

    <AuthorizeView>
        <Authorized>
            <div class="px-3 py-2 mt-2 border-top">
                <div class="text-white-50 small mb-2">@context.User.Identity?.Name</div>
                <button class="btn btn-sm btn-outline-light w-100" @onclick="HandleLogoutAsync">ログアウト</button>
            </div>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    [Inject] private AuthService AuthService { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private async Task HandleLogoutAsync()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/login");
    }
}

