@page "/"
@page "/dashboard"
@inject ProjectService ProjectService
@inject TaskService TaskService

<PageTitle>ダッシュボード - TaskFlow</PageTitle>

<h1 class="mb-4">ダッシュボード</h1>

@if (isLoading)
{
    <p class="text-muted">読み込み中...</p>
}
else
{
    @if (loadError is not null)
    {
        <div class="alert alert-danger">@loadError</div>
    }

    <div class="row g-3">
        <div class="col-md-7">
            <ProjectCardList Projects="projects" OnCreateClicked="OpenCreateModal" />
        </div>
        <div class="col-md-5">
            <MyTaskList Tasks="myTasks" />
        </div>
    </div>
}

@if (showCreateModal)
{
    <CreateProjectModal OnClose="CloseCreateModal" OnCreated="HandleProjectCreatedAsync" />
}

@code {
    private IReadOnlyList<ProjectResponse> projects = [];
    private IReadOnlyList<MyTaskResponse> myTasks = [];
    private bool isLoading = true;
    private string? loadError;
    private bool showCreateModal;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        isLoading = true;
        loadError = null;

        var projectsTask = ProjectService.GetProjectsAsync();
        var tasksTask = TaskService.GetMyTasksAsync();
        await Task.WhenAll(projectsTask, tasksTask);

        var projectsResult = await projectsTask;
        var tasksResult = await tasksTask;

        if (projectsResult.Succeeded)
            projects = projectsResult.Data!;
        if (tasksResult.Succeeded)
            myTasks = tasksResult.Data!;

        if (!projectsResult.Succeeded || !tasksResult.Succeeded)
            loadError = "データの取得に失敗しました。時間をおいて再度お試しください。";

        isLoading = false;
    }

    private void OpenCreateModal() => showCreateModal = true;

    private void CloseCreateModal() => showCreateModal = false;

    private async Task HandleProjectCreatedAsync(ProjectResponse project)
    {
        projects = [.. projects, project];
        showCreateModal = false;
        await Task.CompletedTask;
    }
}
