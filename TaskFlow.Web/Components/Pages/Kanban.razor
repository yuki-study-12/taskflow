@page "/projects/{ProjectId:guid}/board"
@using Microsoft.AspNetCore.SignalR.Client
@inject BoardService BoardService
@inject ProjectService ProjectService
@inject IConfiguration Configuration
@implements IAsyncDisposable

<PageTitle>かんばんボード - TaskFlow</PageTitle>

<h1 class="mb-4">@(boardName ?? "かんばんボード")</h1>

@if (isLoading)
{
    <p class="text-muted">読み込み中...</p>
}
else if (loadError is not null)
{
    <div class="alert alert-danger">@loadError</div>
}
else if (boardId is null)
{
    <div class="alert alert-secondary">
        このプロジェクトにはまだボードがありません。
        <button class="btn btn-sm btn-primary ms-2" @onclick="CreateDefaultBoardAsync" disabled="@isCreatingBoard">
            ボードを作成
        </button>
    </div>
}
else
{
    @if (hubConnected)
    {
        <div class="alert alert-success py-1 px-3 mb-3 d-inline-flex align-items-center gap-2" role="status">
            <span class="badge bg-success rounded-circle p-1"></span> リアルタイム同期中
        </div>
    }

    <KanbanBoard Columns="columns" OnCardMoved="HandleCardMovedAsync" OnCardClicked="OpenModal" />
}

@if (showModal && selectedTask is not null)
{
    <TaskDetailModal
        TaskItem="selectedTask"
        Members="members"
        OnClose="CloseModal"
        OnTaskUpdated="StateHasChanged" />
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    private List<KanbanColumnState> columns = [];
    private IReadOnlyList<MemberResponse> members = [];
    private Guid? boardId;
    private string? boardName;
    private bool isLoading = true;
    private bool isCreatingBoard;
    private string? loadError;
    private HubConnection? hubConnection;
    private bool hubConnected;
    private bool showModal;
    private KanbanTaskState? selectedTask;

    private sealed record TaskMovedPayload(Guid Id, Guid ColumnId, string Title, string? Description, Guid? AssigneeId, int Order);

    protected override async Task OnInitializedAsync()
    {
        await LoadBoardAsync();
        await LoadMembersAsync();
    }

    private async Task LoadBoardAsync()
    {
        isLoading = true;
        loadError = null;

        var result = await BoardService.GetBoardAsync(ProjectId);
        if (!result.Succeeded)
        {
            // ボード未作成の場合もエラー扱いで返るため、空状態として案内する
            boardId = null;
            isLoading = false;
            return;
        }

        ApplyBoard(result.Data!);
        isLoading = false;

        await ConnectSignalRAsync();
    }

    private async Task LoadMembersAsync()
    {
        var result = await ProjectService.GetMembersAsync(ProjectId);
        if (result.Succeeded)
            members = result.Data!;
    }

    private void ApplyBoard(BoardResponse board)
    {
        boardId = board.Id;
        boardName = board.Name;
        columns = board.Columns
            .OrderBy(c => c.Order)
            .Select(c => new KanbanColumnState
            {
                Id = c.Id,
                Name = c.Name,
                Order = c.Order,
                Tasks = [.. c.Tasks
                    .OrderBy(t => t.Order)
                    .Select(t => new KanbanTaskState
                    {
                        Id = t.Id,
                        Title = t.Title,
                        Description = t.Description,
                        AssigneeId = t.AssigneeId,
                        DueDate = t.DueDate,
                        Priority = t.Priority,
                    })],
            })
            .ToList();
    }

    private async Task CreateDefaultBoardAsync()
    {
        isCreatingBoard = true;

        var boardResult = await BoardService.CreateBoardAsync(ProjectId, "ボード");
        if (!boardResult.Succeeded)
        {
            loadError = "ボードの作成に失敗しました。";
            isCreatingBoard = false;
            return;
        }

        foreach (var name in new[] { "ToDo", "進行中", "完了" })
            await BoardService.CreateColumnAsync(boardResult.Data!.Id, name);

        isCreatingBoard = false;
        await LoadBoardAsync();
    }

    private async Task ConnectSignalRAsync()
    {
        if (boardId is null)
            return;

        var apiBaseUrl = Configuration["ApiBaseUrl"] ?? "https://localhost:7192";
        var hubUrl = $"{apiBaseUrl.TrimEnd('/')}/hubs/board";

        hubConnection = new HubConnectionBuilder()
            .WithUrl(hubUrl)
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<TaskMovedPayload>("TaskMoved", payload =>
        {
            ApplyRemoteMove(payload);
            return InvokeAsync(StateHasChanged);
        });

        hubConnection.Reconnected += _ =>
        {
            hubConnected = true;
            return InvokeAsync(StateHasChanged);
        };

        hubConnection.Closed += _ =>
        {
            hubConnected = false;
            return InvokeAsync(StateHasChanged);
        };

        try
        {
            await hubConnection.StartAsync();
            await hubConnection.SendAsync("JoinBoard", boardId.Value.ToString());
            hubConnected = true;
        }
        catch
        {
            hubConnected = false;
        }
    }

    private void ApplyRemoteMove(TaskMovedPayload payload)
    {
        var task = RemoveTaskFromColumns(payload.Id) ?? new KanbanTaskState
        {
            Id = payload.Id,
            Title = payload.Title,
            Description = payload.Description ?? string.Empty,
            AssigneeId = payload.AssigneeId,
        };

        task.Title = payload.Title;
        task.Description = payload.Description ?? string.Empty;
        task.AssigneeId = payload.AssigneeId;

        var targetColumn = columns.FirstOrDefault(c => c.Id == payload.ColumnId);
        if (targetColumn is null)
            return;

        var index = Math.Clamp(payload.Order, 0, targetColumn.Tasks.Count);
        targetColumn.Tasks.Insert(index, task);
    }

    private async Task HandleCardMovedAsync((Guid TaskId, Guid TargetColumnId, int NewIndex) move)
    {
        // SortableJS が既にDOM上でカードを移動済みのため、モデル側も即座に合わせておく
        var task = RemoveTaskFromColumns(move.TaskId);
        var targetColumn = columns.FirstOrDefault(c => c.Id == move.TargetColumnId);
        if (task is not null && targetColumn is not null)
        {
            var index = Math.Clamp(move.NewIndex, 0, targetColumn.Tasks.Count);
            targetColumn.Tasks.Insert(index, task);
        }

        var result = await BoardService.MoveTaskAsync(move.TaskId, move.TargetColumnId, move.NewIndex);
        if (!result.Succeeded)
        {
            // サーバー側と状態がズレた可能性があるため再取得する
            await LoadBoardAsync();
        }
    }

    private KanbanTaskState? RemoveTaskFromColumns(Guid taskId)
    {
        foreach (var column in columns)
        {
            var existing = column.Tasks.FirstOrDefault(t => t.Id == taskId);
            if (existing is not null)
            {
                column.Tasks.Remove(existing);
                return existing;
            }
        }

        return null;
    }

    private void OpenModal(KanbanTaskState task)
    {
        selectedTask = task;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        selectedTask = null;
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
            await hubConnection.DisposeAsync();
    }
}
