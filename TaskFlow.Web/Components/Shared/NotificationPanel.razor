<div class="position-relative d-inline-block">
    <button class="btn btn-link p-0 position-relative text-decoration-none"
            style="color: inherit;"
            @onclick="TogglePanel"
            aria-label="通知">
        <span style="font-size: 1.3rem;">🔔</span>
        @if (unreadCount > 0)
        {
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                  style="font-size: 0.65rem;">
                @unreadCount
            </span>
        }
    </button>

    @if (isPanelOpen)
    {
        <div class="card shadow position-absolute end-0 mt-2"
             style="width: 320px; z-index: 1050;">
            <div class="card-header d-flex justify-content-between align-items-center py-2">
                <span class="fw-semibold">通知</span>
                <button class="btn-close btn-sm" @onclick="TogglePanel" aria-label="閉じる"></button>
            </div>
            <ul class="list-group list-group-flush" style="max-height: 320px; overflow-y: auto;">
                @foreach (var n in notifications)
                {
                    <li class="list-group-item @(n.IsRead ? "" : "list-group-item-primary")">
                        <div class="fw-semibold small">@n.Title</div>
                        <div class="text-muted" style="font-size: 0.8rem;">@n.Body</div>
                        <div class="text-muted" style="font-size: 0.7rem;">@n.Time</div>
                    </li>
                }
            </ul>
        </div>
    }
</div>

@code {
    private record Notification(string Title, string Body, string Time, bool IsRead);

    private bool isPanelOpen = false;
    private int unreadCount = 2;

    private List<Notification> notifications =
    [
        new("タスクが割り当てられました", "「ログイン画面デザイン」があなたに割り当てられました", "5分前", false),
        new("期限が近づいています", "「APIエンドポイント実装」の期限は明日です", "1時間前", false),
        new("コメントが追加されました", "「かんばんボード」にコメントが追加されました", "3時間前", true),
    ];

    private void TogglePanel() => isPanelOpen = !isPanelOpen;
}
